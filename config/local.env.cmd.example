@echo off
rem 発表用ローカルDB設定のひな型です。
rem このファイルを config\local.env.cmd にコピーし、実際のパスワードに変更。
rem 実パスワードを含む local.env.cmd は.gitignoreで公開対象外です。
set "LOTTERY_DB_BACKEND=mysql"
set "LOTTERY_DB_HOST=127.0.0.1"
set "LOTTERY_DB_PORT=3306"
set "LOTTERY_DB_USER=tre_lottery_app"
set "LOTTERY_DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD"
set "LOTTERY_DB_NAME=tre_lottery"
